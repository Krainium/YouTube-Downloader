# ---------------------------------------------------------------------------
# VLESS exit pool.
#
# YouTube bot-blocks datacenter IPs, so requests leave through a pool of VLESS
# nodes. Xray-core runs inside the container (see Dockerfile.vercel) and exposes
# one local HTTP proxy port per node.

# The node list, one vless:// URI per line. Set this in the Vercel project
# environment — it is deliberately not committed.
VLESS_NODES=

# First local port Xray listens on; node i is reachable at BASE_PORT + i.
XRAY_BASE_PORT=10809

# Credentials for those local inbounds. Loopback-only, so they exist to satisfy
# the proxy client rather than to protect anything.
XRAY_PROXY_USER=ytdl
XRAY_PROXY_PASS=local

# Per-request timeout for the proxy tunnel, in ms.
PROXY_TIMEOUT_MS=20000

# Set to 1 to log which exit and client answered.
YTDL_DEBUG=

# Optional: raw "Cookie" header from an authenticated youtube.com session.
# Improves success on age- or label-restricted videos (enables the WEB client
# with SAPISIDHASH auth). Copy from DevTools > Network > any youtube.com request.
YOUTUBE_COOKIES=
