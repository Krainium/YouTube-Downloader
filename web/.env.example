# ---------------------------------------------------------------------------
# Residential proxy for YouTube extraction and streaming.
#
# YouTube bot-blocks datacenter IPs (Vercel, AWS, OVH, etc.), so a residential
# proxy is required for both the player API call and the CDN download. Use a
# sticky session so extraction and download share one exit IP — YouTube binds
# each CDN URL to the IP that requested it, so the two must match.
#
# Format: http://USER:PASS@HOST:PORT
# Example (ProxyScrape residential, sticky session, 10-minute lifetime):
#   PROXY_URL=http://USER-session-ytdlweb-lifetime-10:PASS@rp.scrapegw.com:6060
PROXY_URL=

# Optional: raw "Cookie" header from an authenticated youtube.com session.
# Improves success on age- or label-restricted videos (enables the WEB client
# with SAPISIDHASH auth). Copy from DevTools > Network > any youtube.com request.
YOUTUBE_COOKIES=
